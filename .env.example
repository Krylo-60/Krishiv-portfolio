GOOGLE_API_KEY=your_google_gemini_api_key_here
# Optional: comma-separated key pool for rotation/failover
GOOGLE_API_KEYS=
# Optional: model override
GOOGLE_MODEL=gemini-2.5-flash

# Shared review storage (required in production for globally visible reviews)
# Preferred professional storage (Postgres)
REVIEW_DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Optional aliases (if your provider sets these automatically)
DATABASE_URL=
POSTGRES_URL=

# Firebase Realtime Database (free-tier friendly shared storage)
FIREBASE_DB_URL=https://your-project-id-default-rtdb.firebaseio.com
# Optional if your DB rules require auth token
FIREBASE_DB_AUTH=

# Optional alternative (Vercel KV/Upstash)
KV_REST_API_URL=your_vercel_kv_rest_url
KV_REST_API_TOKEN=your_vercel_kv_rest_token
REVIEW_STORAGE_KEY=reviews:global:v1

# Creator delete access control
REVIEW_ADMIN_TOKEN=choose_a_strong_secret_token

# YouTube portfolio auto-sync (optional)
# If set, /api/yt-portfolio-sync will auto-fill subs/views/videos from YouTube.
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
# Optional: comma-separated key pool
YOUTUBE_API_KEYS=
# Channel targeting (prefer channel ID; handle also supported)
YT_CHANNEL_ID=
YT_CHANNEL_HANDLE=
YT_CHANNEL_HANDLES=KryloBlox60,Krylo-60
YT_CHANNEL_USERNAME=
# Set to false to disable auto-sync
YT_AUTO_SYNC=true
